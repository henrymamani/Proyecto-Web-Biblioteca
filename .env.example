# Base de datos
DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

# Django (en producción usa DEBUG=False, una clave aleatoria y tu dominio HTTPS)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Google OAuth 2.0: no subas estos valores al repositorio.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_DOMAIN=sistemas.edu.bo
# En desarrollo: http://127.0.0.1:8000/ingresar/google/retorno/
# En produccion: usa la URL publica HTTPS exacta de esta ruta.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/ingresar/google/retorno/
